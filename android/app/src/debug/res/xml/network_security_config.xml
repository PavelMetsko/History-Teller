<?xml version="1.0" encoding="utf-8"?>
<!-- Только для отладочной сборки: локальный стенд контента (tools/publish_content.py serve)
     раздаётся по http, а Android с 9-й версии блокирует незашифрованный трафик.
     Релиз ходит на https://cdn.historyteller.app и этого файла не видит. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.68</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

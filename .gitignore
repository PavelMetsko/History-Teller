# Generated Xcode project (пересоздаётся из Unity: HistoryTeller → Build iOS)
ios-build/

# Unity (дублирует UnityProject/.gitignore на всякий случай)
UnityProject/[Ll]ibrary/
UnityProject/[Tt]emp/
UnityProject/[Oo]bj/
UnityProject/[Ll]ogs/
UnityProject/[Uu]ser[Ss]ettings/

# Tuist-сгенерированное (пересоздаётся: cd ios && tuist generate)
ios/*.xcodeproj
ios/*.xcworkspace
ios/Derived/
ios/.build/
ios/**/.build/

# OS / IDE
.DS_Store
.idea/
.vs/

# Android
android/.gradle/
android/build/
android/*/build/
android/local.properties
android/.idea/

# iOS build output (артефакты сборки — НЕ коммитить; там Assets.car >100МБ)
ios/build/
ios/build_device/
ios/build_sim/
ios/build*/
ios/DerivedData/
**/build_device/
**/build_sim/

# Облачный бандл контента (пересобирается: python3 tools/publish_content.py)
dist/

# Ключи R2 — НЕ коммитить
.r2.env

# Движок редактора — собирается из :engine-js
editor/engine.js

.claude/settings.local.json
